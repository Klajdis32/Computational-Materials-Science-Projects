&CONTROL
    calculation = 'bands',
    prefix = 'si',
    pseudo_dir = '/home/k/ktsami/LAMMPS_tests/edw',
    outdir = './output/'
/

&SYSTEM
    ibrav = 2,
    celldm(1) = 10.30,
    nat = 2,
    ntyp = 1,
    ecutwfc = 50,
    nbnd = 8,
/

&ELECTRONS
    conv_thr = 1.0d-8,
/

ATOMIC_SPECIES
Si 28.085 Si.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS crystal
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25

K_POINTS tpiba
